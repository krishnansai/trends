NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Python ingestion script
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=fashion-garments

# Optional local vision model for /stylist photo analysis.
# CPU works, but image analysis is slower than GPU.
OLLAMA_VISION_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_VISION_MODEL=llava:latest
OLLAMA_VISION_TIMEOUT_MS=30000

# Price Finder defaults to local/no-API mode.
# local: direct product URL metadata scraping + retailer search pages for typed queries.
# serpapi: optional live Google Shopping provider for typed queries.
PRICE_FINDER_LIVE_PROVIDER=local
SERPAPI_API_KEY=
