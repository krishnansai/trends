{
  "name": "fashion-trend-forecasting",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "validate:data": "node --experimental-strip-types scripts/validate-local-data.ts",
    "check:links": "node --experimental-strip-types scripts/check-data-links.ts",
    "train:stylist": "node --experimental-strip-types scripts/train-stylist-engine.ts",
    "seed:unsplash": "node scripts/seed-unsplash.mjs",
    "seed:all-trends": "npm run seed:unsplash -- --queries \"minimalist menswear studio|heavyweight oversized streetwear|old money menswear tailoring|japanese workwear aesthetic|2026 minimalist womenswear|monochrome resort wear|tailored women office look|elevated streetwear women|unisex oversized hoodie lookbook|genderless minimalist fashion|classic trench coat street style\" --limit 220 --orientation portrait && npm run validate:data",
    "ingest:kaggle": "node --experimental-strip-types scripts/ingest-kaggle-data.ts",
    "ingest:trends": "node --experimental-strip-types scripts/ingest-trend-data.ts",
    "ingest:grooming": "node --experimental-strip-types scripts/ingest-grooming-data.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "16.2.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.9.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.9",
    "postcss": "8.5.16",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "postcss": "8.5.16"
  }
}
